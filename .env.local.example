# Copy to .env.local for local Docker Compose use. Never commit the copied file.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=ziamis_cem
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-before-use
ENVIRONMENT=development
DEBUG=true
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
REDIS_URL=redis://farmer-redis:6379/0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","capacitor://localhost","ionic://localhost"]

# Frontend build-time API values; set the deployed HTTPS URL for production builds.
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PROD_URL=
VITE_MOBILE_API_URL=
